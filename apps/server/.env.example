# 复制为 apps/server/.env 后按需修改。
# 会话与存储配置的加密密钥，至少 32 个字符；生产环境务必替换。
BETTER_AUTH_SECRET="change-me-to-a-random-32-plus-character-secret"
# 浏览器访问本站的地址（开发时是 Vite 的 5173，生产时是服务器的域名）。
BETTER_AUTH_URL="http://localhost:5173"
# SQLite 数据库文件，相对 apps/server 解析。
DATABASE_URL="./local.db"
PORT="3000"
# 本地/NAS 存储根目录（storage_target 里配置的 rootPath 也相对它之外的绝对路径）。
STORAGE_ROOT="./storage"
# 单个文件上传上限，默认 256MB。
UPLOAD_MAX_BYTES="268435456"

# 可选：LibreOffice 可执行文件，配置后 Office 文档可转 PDF 在线预览。
# Windows 示例：C:\Program Files\LibreOffice\program\soffice.exe
# SOFFICE_PATH=""

# 可选：OnlyOffice Document Server，配置后 docx/xlsx/pptx 可在线编辑。
# ONLYOFFICE_URL="http://localhost:8080"
# ONLYOFFICE_JWT_SECRET=""

# 可选：首次执行 pnpm seed 时创建的超级管理员账号。
# SEED_ROOT_EMAIL="root@medihub.local"
# SEED_ROOT_PASSWORD="Medihub@2026"

# 可选：在线升级（root 在「系统管理 → 版本与升级」操作）。默认关闭。
# 开启后需要同时配置重启命令与安装目录，详见 docs/UPGRADE.md。
# UPDATE_ENABLED="true"
# UPDATE_WORKDIR="/opt/medihub"
# UPDATE_RESTART_CMD="systemctl restart medihub"
# UPDATE_HEALTH_URL="http://127.0.0.1:3000/api/health"
# UPDATE_DB_PATH="apps/server/local.db"
# UPDATE_KEEP_BACKUPS="3"
# UPDATE_REPO="Eunsolfs/medihub"
# UPDATE_GITHUB_TOKEN=""
