{
  "name": "@medihub/server",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "build": "vp pack && node scripts/copy-spa.mjs",
    "start": "node --env-file-if-exists=.env dist/index.mjs",
    "db:migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "seed": "node --env-file-if-exists=.env src/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@medihub/api": "workspace:*",
    "@medihub/auth": "workspace:*",
    "@medihub/db": "workspace:*",
    "@medihub/storage": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@medihub/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
