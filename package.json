{
  "name": "medihub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run --filter @medihub/web build && vp run --filter @medihub/server build",
    "check": "vp check",
    "test": "vp test",
    "seed": "vp run --filter @medihub/server seed",
    "ready": "vp check && vp run knip && vp test && vp run test:e2e && vp run build",
    "prepare": "vp config",
    "db:generate": "vp run --filter @medihub/db db:generate",
    "db:migrate": "vp run --filter @medihub/server db:migrate",
    "db:studio": "vp run --filter @medihub/db db:studio",
    "test:e2e": "vp run --filter @medihub/web test:e2e",
    "knip": "knip"
  },
  "devDependencies": {
    "@medihub/config": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.15.0"
  }
}
